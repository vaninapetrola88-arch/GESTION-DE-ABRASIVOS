<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gestión Abrasivos</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f4f4;color:#222;min-height:100vh}
header{background:#1a3a5c;color:#fff;padding:14px 24px;display:flex;align-items:center;gap:12px}
header h1{font-size:18px;font-weight:600}
header span{font-size:13px;opacity:.7}
.container{max-width:1000px;margin:0 auto;padding:24px 16px}
.nav{display:flex;gap:4px;border-bottom:2px solid #ddd;margin-bottom:24px;flex-wrap:wrap}
.nav-btn{padding:10px 18px;font-size:14px;font-weight:500;border:none;background:none;cursor:pointer;color:#555;border-bottom:3px solid transparent;margin-bottom:-2px}
.nav-btn.active{color:#1a3a5c;border-bottom:3px solid #1a3a5c}
.nav-btn:hover:not(.active){color:#1a3a5c;background:#f0f4f8}
.screen{display:none}.screen.active{display:block}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.metric{background:#fff;border-radius:8px;padding:16px;border:1px solid #e0e0e0;text-align:center}
.metric .lbl{font-size:12px;color:#888;margin-bottom:6px}
.metric .val{font-size:24px;font-weight:700}
.metric .val.green{color:#0a6b45}.metric .val.red{color:#b03030}.metric .val.amber{color:#8a5500}
.card{background:#fff;border-radius:8px;border:1px solid #e0e0e0;padding:20px;margin-bottom:16px}
label{font-size:13px;color:#555;display:block;margin-bottom:4px;font-weight:500}
input,select{width:100%;font-size:14px;border:1px solid #ccc;border-radius:6px;padding:8px 10px;background:#fff;color:#222}
input:focus,select:focus{outline:none;border-color:#1a3a5c;box-shadow:0 0 0 2px #1a3a5c22}
.row{display:flex;gap:10px;align-items:flex-end;margin-bottom:14px;flex-wrap:wrap}
.row .field{flex:1;min-width:140px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;font-size:13px;font-weight:600;border-radius:6px;cursor:pointer;border:1px solid #ccc;background:#fff;color:#333;transition:background .15s}
.btn:hover{background:#f0f4f8}
.btn.primary{background:#1a3a5c;color:#fff;border-color:#1a3a5c}.btn.primary:hover{background:#122d47}
.btn.success{background:#0a6b45;color:#fff;border-color:#0a6b45}.btn.success:hover{background:#085535}
.btn.danger{background:#fff;color:#b03030;border-color:#f5a0a0}.btn.danger:hover{background:#fff0f0}
.btn.sm{padding:5px 10px;font-size:12px}
.btn:disabled{opacity:.5;cursor:not-allowed}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:9px 10px;font-size:12px;font-weight:600;color:#555;border-bottom:2px solid #eee;background:#fafafa}
td{padding:9px 10px;border-bottom:1px solid #f0f0f0;color:#222;vertical-align:middle}
tr:hover td{background:#f7f9fc}
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700}
.badge.cobrado{background:#d4f0e4;color:#0a5c35}
.badge.pendiente{background:#fef0d0;color:#7a4800}
.badge.parcial{background:#ddeeff;color:#1a3a5c}
.sect-title{font-size:15px;font-weight:700;color:#1a3a5c;margin-bottom:14px;border-left:3px solid #1a3a5c;padding-left:10px}
.item-row{display:grid;grid-template-columns:2fr 80px 110px 90px 36px;gap:8px;align-items:center;margin-bottom:8px}
.total-box{background:#f0f9f5;border:1px solid #b0ddc8;border-radius:8px;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;margin-top:14px}
.divider{height:1px;background:#eee;margin:24px 0}
.empty{color:#aaa;font-size:13px;text-align:center;padding:28px 0}
.saldo-verde{background:#d4f0e4;color:#0a5c35;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700}
.saldo-rojo{background:#fde0e0;color:#8a1f1f;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700}
.presup-header{background:#f7f9fc;border:1px solid #dde4ee;border-radius:8px;padding:16px;margin-bottom:16px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.status-bar{display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:6px;font-size:13px;margin-bottom:16px}
.status-bar.ok{background:#d4f0e4;color:#0a5c35}
.status-bar.error{background:#fde0e0;color:#8a1f1f}
.status-bar.loading{background:#e8f0fe;color:#174ea6}
.spinner{width:16px;height:16px;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:600px){
  .grid4{grid-template-columns:1fr 1fr}
  .grid2{grid-template-columns:1fr}
  .item-row{grid-template-columns:1fr 60px 80px 70px 30px}
  header h1{font-size:15px}
}
</style>
</head>
<body>
<header>
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="13" fill="#fff2" stroke="#fff" stroke-width="1.5"/><path d="M8 14h12M14 8v12" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
  <div>
    <h1>Sistema de Gestión — Abrasivos Especiales</h1>
    <span id="fecha-hoy"></span>
  </div>
</header>

<div class="container">

<div id="status-bar" class="status-bar loading">
  <div class="spinner"></div>
  <span>Conectando con Google Sheets...</span>
</div>

<div class="nav">
  <button class="nav-btn active" onclick="showScreen('ventas',this)">📊 Ventas del mes</button>
  <button class="nav-btn" onclick="showScreen('presupuesto',this)">📄 Nuevo presupuesto</button>
  <button class="nav-btn" onclick="showScreen('ctacte',this)">👥 Cuenta corriente</button>
  <button class="nav-btn" onclick="showScreen('cobros',this)">💵 Cobros</button>
</div>

<!-- VENTAS -->
<div id="s-ventas" class="screen active">
  <div class="grid4">
    <div class="metric"><div class="lbl">Ventas del mes</div><div class="val green" id="m-total">$0</div></div>
    <div class="metric"><div class="lbl">Presupuestos</div><div class="val" id="m-count">0</div></div>
    <div class="metric"><div class="lbl">Cobrado</div><div class="val green" id="m-cobrado">$0</div></div>
    <div class="metric"><div class="lbl">Pendiente</div><div class="val amber" id="m-pendiente">$0</div></div>
  </div>
  <div class="card">
    <div class="sect-title">Registrar venta rápida</div>
    <div class="row">
      <div class="field"><label>Cliente</label><input type="text" id="v-cliente" placeholder="Nombre o empresa"/></div>
      <div class="field"><label>Producto / descripción</label><input type="text" id="v-producto" placeholder="Ej: Disco abrasivo 230mm T27"/></div>
    </div>
    <div class="row">
      <div class="field"><label>Cantidad</label><input type="number" id="v-cantidad" value="1" min="1"/></div>
      <div class="field"><label>Precio unitario ($)</label><input type="number" id="v-precio" placeholder="0.00"/></div>
      <div class="field"><label>Fecha</label><input type="date" id="v-fecha"/></div>
      <div class="field"><label>Estado</label>
        <select id="v-estado">
          <option value="pendiente">Pendiente</option>
          <option value="cobrado">Cobrado</option>
          <option value="parcial">Parcial</option>
        </select>
      </div>
    </div>
    <button class="btn primary" id="btn-venta" onclick="registrarVenta()">+ Registrar venta</button>
  </div>
  <div class="divider"></div>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <div class="sect-title" style="margin-bottom:0">Historial del mes</div>
    <button class="btn sm" onclick="exportarCSV()">📥 Exportar Excel</button>
  </div>
  <table>
    <thead><tr><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Cant.</th><th style="text-align:right">Precio unit.</th><th style="text-align:right">Total</th><th>Estado</th><th></th></tr></thead>
    <tbody id="tabla-ventas"><tr><td colspan="8" class="empty">Cargando...</td></tr></tbody>
  </table>
</div>

<!-- PRESUPUESTO -->
<div id="s-presupuesto" class="screen">
  <div class="presup-header">
    <div class="grid2">
      <div><label>Cliente</label><input type="text" id="p-cliente" placeholder="Nombre o empresa"/></div>
      <div><label>Fecha</label><input type="date" id="p-fecha"/></div>
    </div>
    <div><label>Observaciones / condiciones</label><input type="text" id="p-obs" placeholder="Ej: Entrega en 5 días hábiles. Válido por 7 días."/></div>
  </div>
  <div class="sect-title">Ítems del presupuesto</div>
  <div style="display:grid;grid-template-columns:2fr 80px 110px 90px 36px;gap:8px;margin-bottom:6px;padding:0 2px">
    <span style="font-size:12px;color:#888;font-weight:600">Descripción</span>
    <span style="font-size:12px;color:#888;font-weight:600">Cant.</span>
    <span style="font-size:12px;color:#888;font-weight:600">P. unitario ($)</span>
    <span style="font-size:12px;color:#888;font-weight:600">Subtotal</span>
    <span></span>
  </div>
  <div id="items-container"></div>
  <button class="btn sm" onclick="addItem()" style="margin-bottom:14px">+ Agregar ítem</button>
  <div class="total-box">
    <span style="font-size:15px;font-weight:700">Total del presupuesto</span>
    <span style="font-size:24px;font-weight:700;color:#0a6b45" id="p-total">$0,00</span>
  </div>
  <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
    <button class="btn primary" id="btn-presup" onclick="guardarPresupuesto()">✓ Guardar y pasar a ventas</button>
    <button class="btn" onclick="imprimirPresupuesto()">🖨️ Imprimir / PDF</button>
    <button class="btn" onclick="limpiarPresupuesto()">✕ Limpiar</button>
  </div>
</div>

<!-- CUENTA CORRIENTE -->
<div id="s-ctacte" class="screen">
  <div class="row" style="margin-bottom:16px">
    <div class="field" style="max-width:320px"><label>Filtrar por cliente</label>
      <select id="filtro-cliente" onchange="renderCtaCte()">
        <option value="">— Todos los clientes —</option>
      </select>
    </div>
  </div>
  <div class="grid2" style="margin-bottom:20px">
    <div class="metric"><div class="lbl">Total facturado (histórico)</div><div class="val green" id="cte-facturado">$0</div></div>
    <div class="metric"><div class="lbl">Saldo pendiente de cobro</div><div class="val red" id="cte-deuda">$0</div></div>
  </div>
  <div id="cte-contenido"></div>
</div>

<!-- COBROS -->
<div id="s-cobros" class="screen">
  <div class="card" style="margin-bottom:20px">
    <div class="sect-title">Registrar cobro</div>
    <div class="row">
      <div class="field"><label>Cliente</label>
        <select id="c-cliente"><option value="">Seleccionar cliente...</option></select>
      </div>
      <div class="field"><label>Importe cobrado ($)</label><input type="number" id="c-monto" placeholder="0.00"/></div>
      <div class="field"><label>Fecha</label><input type="date" id="c-fecha"/></div>
      <div class="field"><label>Forma de pago</label>
        <select id="c-forma">
          <option>Efectivo</option>
          <option>Transferencia</option>
          <option>Cheque</option>
          <option>Mercado Pago</option>
          <option>Otro</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="field" style="max-width:400px"><label>Referencia / nota (opcional)</label><input type="text" id="c-nota" placeholder="Ej: Transferencia CBU, Cheque nro 1234..."/></div>
    </div>
    <button class="btn success" id="btn-cobro" onclick="registrarCobro()">💵 Registrar cobro</button>
  </div>
  <div class="sect-title">Historial de cobros</div>
  <table>
    <thead><tr><th>Fecha</th><th>Cliente</th><th style="text-align:right">Importe</th><th>Forma de pago</th><th>Referencia</th></tr></thead>
    <tbody id="tabla-cobros"><tr><td colspan="5" class="empty">Cargando...</td></tr></tbody>
  </table>
</div>

</div><!-- /container -->

<script>
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyLxs7SNL1zKqZea5deWCO7VS2uWtxI-dNUw4IKQkE51RR9HfLwOxFSSVSOMgUNnxuGtw/exec';

const $ = id => document.getElementById(id);
const fmt = n => '$' + Number(n).toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});
const today = () => new Date().toISOString().slice(0,10);
const fmtFecha = f => {
  if(!f) return '';
  const s = String(f).slice(0,10);
  const d = new Date(s+'T00:00:00');
  return d.toLocaleDateString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'});
};

$('fecha-hoy').textContent = new Date().toLocaleDateString('es-AR',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
$('v-fecha').value = today();
$('p-fecha').value = today();
$('c-fecha').value = today();

let data = { ventas: [], cobros: [] };
let itemCount = 0;
let currentScreen = 'ventas';

function setStatus(tipo, msg) {
  const bar = $('status-bar');
  bar.className = 'status-bar ' + tipo;
  bar.innerHTML = tipo === 'loading'
    ? '<div class="spinner"></div><span>' + msg + '</span>'
    : '<span>' + (tipo==='ok'?'✓ ':'⚠ ') + msg + '</span>';
}

async function api(params) {
  const url = new URL(SCRIPT_URL);
  Object.keys(params).forEach(k => url.searchParams.set(k, params[k]));
  const res = await fetch(url.toString());
  return await res.json();
}

async function cargarDatos() {
  setStatus('loading', 'Conectando con Google Sheets...');
  try {
    const r = await api({ action: 'getData' });
    if(r.ok) {
      data.ventas = (r.ventas || []).map(v => ({
        id: String(v.id),
        fecha: String(v.fecha).slice(0,10),
        cliente: v.cliente,
        producto: v.producto,
        cantidad: Number(v.cantidad),
        precio: Number(v.precio),
        total: Number(v.total),
        estado: v.estado
      }));
      data.cobros = (r.cobros || []).map(c => ({
        id: String(c.id),
        fecha: String(c.fecha).slice(0,10),
        cliente: c.cliente,
        monto: Number(c.monto),
        forma: c.forma,
        nota: c.nota || ''
      }));
      setStatus('ok', 'Conectado con Google Sheets — datos actualizados');
      renderAll();
    } else {
      setStatus('error', 'Error al cargar datos: ' + (r.error||'desconocido'));
    }
  } catch(e) {
    setStatus('error', 'No se pudo conectar con Google Sheets. Verificá tu conexión.');
  }
}

function renderAll() {
  updateSelects();
  renderVentas();
  if(currentScreen === 'ctacte') renderCtaCte();
  if(currentScreen === 'cobros') renderCobros();
}

function showScreen(id, btn) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  $('s-'+id).classList.add('active');
  btn.classList.add('active');
  currentScreen = id;
  if(id==='ventas') renderVentas();
  if(id==='ctacte') { updateSelects(); renderCtaCte(); }
  if(id==='cobros') { updateSelects(); renderCobros(); }
}

function getClientes() {
  return [...new Set(data.ventas.map(v=>v.cliente).filter(Boolean))].sort();
}

function updateSelects() {
  const clientes = getClientes();
  ['filtro-cliente','c-cliente'].forEach(id => {
    const sel = $(id); if(!sel) return;
    const val = sel.value;
    const first = id==='filtro-cliente'
      ? '<option value="">— Todos los clientes —</option>'
      : '<option value="">Seleccionar cliente...</option>';
    sel.innerHTML = first + clientes.map(c=>`<option value="${c}"${c===val?' selected':''}>${c}</option>`).join('');
  });
}

function renderVentas() {
  const now = new Date();
  const esMes = v => {
    const d = new Date(v.fecha+'T00:00:00');
    return d.getFullYear()===now.getFullYear() && d.getMonth()===now.getMonth();
  };
  const mes = data.ventas.filter(esMes);
  const total = mes.reduce((s,v)=>s+v.total,0);
  const cobrado = mes.filter(v=>v.estado==='cobrado').reduce((s,v)=>s+v.total,0);
  const pendiente = mes.filter(v=>v.estado!=='cobrado').reduce((s,v)=>s+v.total,0);
  $('m-total').textContent = fmt(total);
  $('m-count').textContent = mes.length;
  $('m-cobrado').textContent = fmt(cobrado);
  $('m-pendiente').textContent = fmt(pendiente);

  const tbody = $('tabla-ventas');
  if(!data.ventas.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty">Aún no hay ventas registradas.</td></tr>';
    return;
  }
  tbody.innerHTML = [...data.ventas]
    .sort((a,b)=>b.fecha.localeCompare(a.fecha))
    .map(v => `<tr>
      <td>${fmtFecha(v.fecha)}</td>
      <td><strong>${v.cliente}</strong></td>
      <td>${v.producto}</td>
      <td style="text-align:center">${v.cantidad}</td>
      <td style="text-align:right">${fmt(v.precio)}</td>
      <td style="text-align:right;font-weight:700">${fmt(v.total)}</td>
      <td><span class="badge ${v.estado}">${v.estado.charAt(0).toUpperCase()+v.estado.slice(1)}</span></td>
      <td><button class="btn danger sm" onclick="eliminarVenta('${v.id}')" title="Eliminar">🗑</button></td>
    </tr>`).join('');
}

async function registrarVenta() {
  const cliente=$('v-cliente').value.trim(), producto=$('v-producto').value.trim();
  const cantidad=parseFloat($('v-cantidad').value)||1, precio=parseFloat($('v-precio').value)||0;
  const fecha=$('v-fecha').value||today(), estado=$('v-estado').value;
  if(!cliente||!producto||!precio){alert('Completá cliente, producto y precio.');return;}
  const btn = $('btn-venta');
  btn.disabled = true; btn.textContent = 'Guardando...';
  const id = Date.now().toString();
  const total = cantidad * precio;
  try {
    const r = await api({action:'addVenta',id,fecha,cliente,producto,cantidad,precio,total,estado});
    if(r.ok) {
      data.ventas.push({id,fecha,cliente,producto,cantidad,precio,total,estado});
      $('v-cliente').value=''; $('v-producto').value='';
      $('v-cantidad').value=1; $('v-precio').value='';
      updateSelects(); renderVentas();
      setStatus('ok','Venta registrada en Google Sheets ✓');
    } else { alert('Error al guardar: '+(r.error||'desconocido')); }
  } catch(e) { alert('Error de conexión. Verificá internet.'); }
  btn.disabled = false; btn.textContent = '+ Registrar venta';
}

async function eliminarVenta(id) {
  if(!confirm('¿Eliminar esta venta? No se puede deshacer.')) return;
  try {
    const r = await api({action:'deleteVenta',id});
    if(r.ok) {
      data.ventas = data.ventas.filter(v=>v.id!==id);
      renderVentas();
      setStatus('ok','Venta eliminada ✓');
    } else { alert('Error: '+(r.error||'desconocido')); }
  } catch(e) { alert('Error de conexión.'); }
}

// PRESUPUESTO
let itemCountLocal = 0;
function addItem(desc='',cant=1,precio=0) {
  itemCountLocal++;
  const id = 'item-'+itemCountLocal;
  const div = document.createElement('div');
  div.className='item-row'; div.id=id;
  div.innerHTML=`
    <input type="text" placeholder="Descripción del producto" value="${desc}" oninput="calcTotal()"/>
    <input type="number" value="${cant}" min="1" oninput="calcTotal()"/>
    <input type="number" value="${precio||''}" placeholder="0.00" oninput="calcTotal()"/>
    <span style="font-size:14px;font-weight:700;color:#0a6b45" id="sub-${itemCountLocal}">$0,00</span>
    <button class="btn danger sm" onclick="this.parentElement.remove();calcTotal()" title="Eliminar">✕</button>
  `;
  $('items-container').appendChild(div);
  calcTotal();
}

function calcTotal() {
  let total = 0;
  $('items-container').querySelectorAll('.item-row').forEach(row => {
    const inp = row.querySelectorAll('input');
    const c=parseFloat(inp[1].value)||0, p=parseFloat(inp[2].value)||0, s=c*p;
    total += s;
    const idx = row.id.replace('item-','');
    const sp = document.getElementById('sub-'+idx);
    if(sp) sp.textContent = fmt(s);
  });
  $('p-total').textContent = fmt(total);
}

function limpiarPresupuesto() {
  $('p-cliente').value=''; $('p-obs').value=''; $('p-fecha').value=today();
  $('items-container').innerHTML=''; $('p-total').textContent='$0,00';
  itemCountLocal=0; addItem();
}

async function guardarPresupuesto() {
  const cliente=$('p-cliente').value.trim(), fecha=$('p-fecha').value||today();
  if(!cliente){alert('Ingresá el nombre del cliente.');return;}
  const rows=$('items-container').querySelectorAll('.item-row');
  if(!rows.length){alert('Agregá al menos un ítem.');return;}
  let productos=[],total=0;
  rows.forEach(row=>{
    const inp=row.querySelectorAll('input');
    const desc=inp[0].value.trim(),cant=parseFloat(inp[1].value)||0,precio=parseFloat(inp[2].value)||0;
    if(desc&&precio){productos.push({desc,cant,precio});total+=cant*precio;}
  });
  if(!total){alert('El presupuesto no tiene importe.');return;}
  const btn=$('btn-presup');
  btn.disabled=true; btn.textContent='Guardando...';
  const resumen=productos.map(p=>p.cant+'x '+p.desc).join(' | ');
  const id=Date.now().toString();
  try {
    const r=await api({action:'addVenta',id,fecha,cliente,producto:resumen,cantidad:1,precio:total,total,estado:'pendiente'});
    if(r.ok){
      data.ventas.push({id,fecha,cliente,producto:resumen,cantidad:1,precio:total,total,estado:'pendiente'});
      updateSelects(); renderVentas();
      setStatus('ok','Presupuesto guardado en Google Sheets ✓');
      alert('Presupuesto guardado y registrado como pendiente de cobro para '+cliente+'.');
      limpiarPresupuesto();
    } else { alert('Error: '+(r.error||'desconocido')); }
  } catch(e){ alert('Error de conexión.'); }
  btn.disabled=false; btn.textContent='✓ Guardar y pasar a ventas';
}

function imprimirPresupuesto() {
  const cliente=$('p-cliente').value.trim()||'(sin cliente)', obs=$('p-obs').value.trim(), fecha=$('p-fecha').value||today();
  const rows=$('items-container').querySelectorAll('.item-row');
