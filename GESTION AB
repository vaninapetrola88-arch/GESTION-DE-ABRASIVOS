    const inp=row.querySelectorAll('input');
    const desc=inp[0].value.trim(),cant=parseFloat(inp[1].value)||0,precio=parseFloat(inp[2].value)||0,sub=cant*precio;
    total+=sub;
    if(desc) filas+=`<tr><td>${desc}</td><td align="center">${cant}</td><td align="right">${fmt(precio)}</td><td align="right"><strong>${fmt(sub)}</strong></td></tr>`;
  });
  if(!filas){alert('Completá los ítems del presupuesto.');return;}
  const nro='P-'+Date.now().toString().slice(-6);
  const html=`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Presupuesto ${nro}</title>
  <style>body{font-family:Arial,sans-serif;max-width:720px;margin:40px auto;padding:0 24px;color:#222;font-size:14px}
  .header{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #1a3a5c;padding-bottom:16px;margin-bottom:24px}
  .empresa{font-size:20px;font-weight:800;color:#1a3a5c}.meta{text-align:right;font-size:13px;color:#555}
  .meta strong{display:block;font-size:15px;color:#222}
  table{width:100%;border-collapse:collapse;margin:16px 0}
  th{background:#1a3a5c;color:#fff;padding:9px 10px;text-align:left;font-size:13px}
  td{padding:9px 10px;border-bottom:1px solid #eee}
  .total-row{background:#f0f9f5;font-size:16px;font-weight:800}
  .obs{background:#fffbe6;border:1px solid #ffe08a;border-radius:6px;padding:12px;margin-top:16px;font-size:13px}
  .footer{margin-top:40px;font-size:12px;color:#aaa;text-align:center;border-top:1px solid #eee;padding-top:16px}
  @media print{body{margin:10px}}</style></head><body>
  <div class="header">
    <div><div class="empresa">Abrasivos Especiales</div><div style="font-size:13px;color:#666;margin-top:4px">Fabricación y venta a pedido</div></div>
    <div class="meta"><strong>Presupuesto N° ${nro}</strong>Fecha: ${fmtFecha(fecha)}<br>Cliente: <strong>${cliente}</strong></div>
  </div>
  <table><thead><tr><th>Descripción</th><th align="center">Cant.</th><th align="right">P. unitario</th><th align="right">Subtotal</th></tr></thead>
  <tbody>${filas}<tr class="total-row"><td colspan="3" align="right">TOTAL</td><td align="right">${fmt(total)}</td></tr></tbody></table>
  ${obs?'<div class="obs"><strong>Observaciones:</strong> '+obs+'</div>':''}
  <div class="footer">Este presupuesto no incluye impuestos &nbsp;|&nbsp; Válido por 7 días corridos</div>
  </body></html>`;
  const w=window.open('','_blank'); w.document.write(html); w.document.close(); setTimeout(()=>w.print(),400);
}

// CUENTA CORRIENTE
function renderCtaCte() {
  const filtro=$('filtro-cliente')?$('filtro-cliente').value:'';
  const clientes=filtro?[filtro]:getClientes();
  const facturadoTotal=data.ventas.reduce((s,v)=>s+v.total,0);
  const cobrosMap=data.cobros.reduce((acc,c)=>{acc[c.cliente]=(acc[c.cliente]||0)+c.monto;return acc;},{});
  const totalCobros=data.cobros.reduce((s,c)=>s+c.monto,0);
  $('cte-facturado').textContent=fmt(facturadoTotal);
  $('cte-deuda').textContent=fmt(Math.max(0,facturadoTotal-totalCobros));
  if(!clientes.length){$('cte-contenido').innerHTML='<div class="empty">Sin clientes registrados aún.</div>';return;}
  let html='';
  clientes.forEach(cli=>{
    const ventas=data.ventas.filter(v=>v.cliente===cli);
    const totalVtas=ventas.reduce((s,v)=>s+v.total,0);
    const totalCob=cobrosMap[cli]||0;
    const saldo=totalVtas-totalCob;
    const saldoLabel=saldo<=0?'Al día ✓':'Debe '+fmt(saldo);
    const saldoClass=saldo<=0?'saldo-verde':'saldo-rojo';
    html+=`<div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <span style="font-size:16px;font-weight:700">${cli}</span>
        <span class="${saldoClass}">${saldoLabel}</span>
      </div>
      <table style="margin-bottom:10px">
        <thead><tr><th>Fecha</th><th>Producto / descripción</th><th style="text-align:right">Importe</th><th>Estado</th></tr></thead>
        <tbody>${ventas.sort((a,b)=>b.fecha.localeCompare(a.fecha)).map(v=>`
          <tr><td>${fmtFecha(v.fecha)}</td><td>${v.producto}</td>
          <td style="text-align:right;font-weight:700">${fmt(v.total)}</td>
          <td><span class="badge ${v.estado}">${v.estado.charAt(0).toUpperCase()+v.estado.slice(1)}</span></td></tr>`).join('')}
        </tbody>
      </table>
      <div style="display:flex;gap:20px;font-size:13px;border-top:1px solid #eee;padding-top:10px;flex-wrap:wrap">
        <span>Facturado: <strong>${fmt(totalVtas)}</strong></span>
        <span>Cobrado: <strong style="color:#0a6b45">${fmt(totalCob)}</strong></span>
        <span>Saldo: <strong style="color:${saldo<=0?'#0a6b45':'#b03030'}">${saldo<=0?'$0,00':fmt(saldo)}</strong></span>
      </div>
    </div>`;
  });
  $('cte-contenido').innerHTML=html;
}

// COBROS
function renderCobros() {
  const tbody=$('tabla-cobros');
  if(!data.cobros.length){tbody.innerHTML='<tr><td colspan="5" class="empty">Sin cobros registrados aún.</td></tr>';return;}
  tbody.innerHTML=[...data.cobros].sort((a,b)=>b.fecha.localeCompare(a.fecha)).map(c=>`
    <tr><td>${fmtFecha(c.fecha)}</td><td><strong>${c.cliente}</strong></td>
    <td style="text-align:right;font-weight:700;color:#0a6b45">${fmt(c.monto)}</td>
    <td>${c.forma}</td><td style="color:#888">${c.nota||'-'}</td></tr>`).join('');
}

async function registrarCobro() {
  const cliente=$('c-cliente').value, monto=parseFloat($('c-monto').value)||0;
  const fecha=$('c-fecha').value||today(), forma=$('c-forma').value, nota=$('c-nota').value.trim();
  if(!cliente||!monto){alert('Seleccioná cliente e ingresá el importe.');return;}
  const btn=$('btn-cobro');
  btn.disabled=true; btn.textContent='Guardando...';
  const id=Date.now().toString();
  try {
    const r=await api({action:'addCobro',id,fecha,cliente,monto,forma,nota});
    if(r.ok){
      data.cobros.push({id,fecha,cliente,monto,forma,nota});
      // actualizar estados localmente
      let restante=monto;
      data.ventas.filter(v=>v.cliente===cliente&&v.estado!=='cobrado')
        .sort((a,b)=>a.fecha.localeCompare(b.fecha))
        .forEach(async v=>{
          if(restante<=0)return;
          const nuevoEstado = restante>=v.total?'cobrado':'parcial';
          restante-=v.total;
          await api({action:'updateEstado',id:v.id,estado:nuevoEstado});
          v.estado=nuevoEstado;
        });
      $('c-monto').value=''; $('c-nota').value='';
      renderCobros(); renderVentas();
      setStatus('ok','Cobro registrado en Google Sheets ✓');
      alert('Cobro de '+fmt(monto)+' registrado para '+cliente+'. Las ventas se actualizaron automáticamente.');
    } else { alert('Error: '+(r.error||'desconocido')); }
  } catch(e){ alert('Error de conexión.'); }
  btn.disabled=false; btn.textContent='💵 Registrar cobro';
}

function exportarCSV() {
  let csv='\uFEFFfecha,cliente,producto,cantidad,precio,total,estado\n';
  data.ventas.forEach(v=>{
    csv+=`"${fmtFecha(v.fecha)}","${v.cliente}","${v.producto}","${v.cantidad}","${v.precio}","${v.total}","${v.estado}"\n`;
  });
  const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url;
  a.download='ventas_abrasivos_'+today()+'.csv';
  a.click(); URL.revokeObjectURL(url);
}

